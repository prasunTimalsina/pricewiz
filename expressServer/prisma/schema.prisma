generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id        Int      @id @default(autoincrement())
  productId Int
  platform  String
  title     String
  price     Float
  imageUrl  String?
  url       String
  scrapedAt DateTime @default(now())
  Product   Product  @relation(fields: [productId], references: [id])
  Track     Track[]

  @@unique([productId, platform, url])
}

model Product {
  id             Int                      @id @default(autoincrement())
  title          String
  popularity     Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  fts_title      Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, title)")) @map("_fts_title")
  Listing        Listing[]
  ProductQueries ProductQueries[]

  @@index([fts_title], map: "Product_title_fts_idx", type: Gin)
}

model ProductQueries {
  productId Int
  queryId   Int
  Product   Product @relation(fields: [productId], references: [id])
  Query     Query   @relation(fields: [queryId], references: [id])

  @@id([productId, queryId])
}

model Query {
  id             Int              @id @default(autoincrement())
  query          String
  nextRunAt      DateTime
  createdAt      DateTime         @default(now())
  ProductQueries ProductQueries[]
}

model Track {
  id        Int      @id @default(autoincrement())
  listingId Int
  minPrice  Int
  email     String
  prodTitle String
  createdAt DateTime @default(now())
  Listing   Listing  @relation(fields: [listingId], references: [id])
}
